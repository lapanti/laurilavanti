---
import type { MDXLayoutProps } from 'astro'
import type { JsonLdType } from '../lib/jsonld'

import HeroBanner from '../components/HeroBanner.astro'
import { sloganContent } from '../content/slogan'
import { getImage } from '../lib/images'
import BaseLayout from './BaseLayout.astro'

type Props = MDXLayoutProps<{
    alt?: string
    description?: string
    faq?: Array<{ a: string; q: string }>
    heroImage?: string
    lang?: 'en' | 'fi' | 'sv'
    mobileHeroImage?: string
    pageTitle: string
    slug?: string
    title: string
    type?: JsonLdType
}>

const { frontmatter } = Astro.props
const { alt, description, faq, heroImage, lang, mobileHeroImage, pageTitle, slug, type } = frontmatter

const ogImage = heroImage ? getImage(heroImage, 'og').src : undefined
const resolvedLang = lang ?? 'fi'
const slogan = sloganContent[resolvedLang]
---

<BaseLayout
    description={description}
    faq={faq}
    headerVariant="hero"
    heroShowsMark
    lang={lang}
    ogImage={ogImage}
    ogImageAlt={alt}
    plated
    slug={slug}
    title={pageTitle}
    type={type}
>
    <HeroBanner
        alt={alt}
        description={description ?? ''}
        heroImage={heroImage}
        lang={resolvedLang}
        mobileHeroImage={mobileHeroImage}
        slogan={slogan}
        slot="banner"
    />
    <slot />
</BaseLayout>
