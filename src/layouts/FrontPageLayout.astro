---
import type { MDXLayoutProps } from 'astro'
import type { JsonLdType } from '../lib/jsonld'

import HeroBanner from '../components/HeroBanner.astro'
import { sloganContent } from '../content/slogan'
import { getImage } from '../lib/images'
import BaseLayout from './BaseLayout.astro'

type Props = MDXLayoutProps<{
    alt?: string
    backgroundImage?: string
    description?: string
    faq?: Array<{ a: string; q: string }>
    heroImage?: string
    lang?: 'en' | 'fi' | 'sv'
    mobileHeroImage?: string
    pageTitle: string
    secondaryTitle?: string
    slug?: string
    title: string
    type?: JsonLdType
    /** Renders the campaign slogan with its typewriter animation instead of `secondaryTitle`. */
    typedSlogan?: boolean
}>

const { frontmatter } = Astro.props
const {
    alt,
    backgroundImage,
    description,
    faq,
    heroImage,
    lang,
    mobileHeroImage,
    pageTitle,
    secondaryTitle,
    slug,
    title,
    type,
    typedSlogan,
} = frontmatter

const ogImage = heroImage ? getImage(heroImage, 'og').src : undefined
const slogan = typedSlogan ? sloganContent[lang ?? 'fi'] : undefined
---

<BaseLayout
    description={description}
    faq={faq}
    lang={lang}
    ogImage={ogImage}
    ogImageAlt={alt}
    plated
    slug={slug}
    title={pageTitle}
    type={type}
>
    <HeroBanner
        alt={alt}
        backgroundImage={backgroundImage}
        heroImage={heroImage}
        mobileHeroImage={mobileHeroImage}
        secondaryTitle={secondaryTitle}
        slogan={slogan}
        slot="banner"
        title={title}
    />
    <slot />
</BaseLayout>
