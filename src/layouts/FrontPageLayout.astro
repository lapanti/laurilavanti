---
import type { MDXLayoutProps } from 'astro'
import type { Lang } from '../content/nav'
import type { FaqItem, JsonLdType } from '../lib/jsonld'

import HeroBanner from '../components/HeroBanner.astro'
import HeroPreloadLinks from '../components/HeroPreloadLinks.astro'
import { sloganContent } from '../content/slogan'
import { getImage } from '../lib/images'
import BaseLayout from './BaseLayout.astro'

type Props = MDXLayoutProps<{
    alt?: string
    description?: string
    faq?: Array<FaqItem>
    heroImage?: string
    lang?: Lang
    mobileHeroImage?: string
    pageTitle: string
    slug?: string
    title: string
    type?: JsonLdType
}>

const { frontmatter } = Astro.props
const { alt, description, faq, heroImage, lang, mobileHeroImage, pageTitle, slug, type } = frontmatter

const ogImage = getImage('og-image-lauri-lavanti', 'ogFlat').src
const resolvedLang = lang ?? 'fi'
const slogan = sloganContent[resolvedLang]
---

<BaseLayout
    description={description}
    faq={faq}
    headerVariant="hero"
    heroShowsMark
    lang={lang}
    ogImage={ogImage}
    ogImageAlt="Lauri Lavanti"
    plated
    slug={slug}
    title={pageTitle}
    type={type}
>
    <Fragment slot="head">
        <HeroPreloadLinks heroImage={heroImage} mobileHeroImage={mobileHeroImage} mode="art-directed" />
    </Fragment>
    <HeroBanner
        alt={alt}
        description={description ?? ''}
        heroImage={heroImage}
        lang={resolvedLang}
        mobileHeroImage={mobileHeroImage}
        slogan={slogan}
        slot="banner"
    />
    <slot />
</BaseLayout>
