---
import type { BreadcrumbItem, JsonLdType } from '../lib/jsonld'

import TitleBanner from '../components/TitleBanner.astro'
import { getImage } from '../lib/images'
import { COLLECTIONPAGE } from '../lib/jsonld'
import BaseLayout from './BaseLayout.astro'

interface Props {
    alt?: string
    createdAt?: string
    ctaHref?: string
    ctaLabel?: string
    description?: string
    emphasis?: string
    eyebrow?: string
    faq?: Array<{ a: string; q: string }>
    heroImage?: string
    intro?: string
    lang?: 'en' | 'fi' | 'sv'
    mobileHeroImage?: string
    noindex?: boolean
    pageTitle: string
    plated?: boolean
    slug?: string
    tags?: string[]
    title: string
    type?: JsonLdType
    updatedAt?: string
    variant?: 'page' | 'split'
}

// Support both MDX layout usage (props under frontmatter) and direct .astro component usage
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const props: Props = ((Astro.props as any).frontmatter as Props | undefined) ?? (Astro.props as Props)
const {
    alt,
    createdAt,
    ctaHref,
    ctaLabel,
    description,
    emphasis,
    eyebrow,
    faq,
    heroImage,
    intro,
    lang,
    mobileHeroImage,
    noindex,
    pageTitle,
    plated = false,
    slug,
    tags,
    title,
    type,
    updatedAt,
    variant = 'page',
} = props

const ogImage = getImage('og-image-lauri-lavanti', 'ogFlat').src

const homeLabel: Record<string, string> = { en: 'Home', fi: 'Etusivu', sv: 'Hem' }
const categoryLabel: Record<string, string> = { en: 'Category', fi: 'Kategoria', sv: 'Kategori' }
const breadcrumbs: BreadcrumbItem[] | undefined =
    type === COLLECTIONPAGE && lang && slug
        ? [
              { name: homeLabel[lang], url: `https://lavanti.fi/${lang}/` },
              { name: categoryLabel[lang], url: `https://lavanti.fi/${slug}/` },
          ]
        : undefined
---

<BaseLayout
    breadcrumbs={breadcrumbs}
    createdAt={createdAt}
    description={description}
    faq={faq}
    headerVariant={variant === 'split' ? 'hero' : 'solid'}
    lang={lang}
    noindex={noindex}
    ogImage={ogImage}
    ogImageAlt="Lauri Lavanti"
    plated={plated}
    slug={slug}
    title={pageTitle}
    type={type}
    updatedAt={updatedAt}
>
    <TitleBanner
        alt={alt}
        createdAt={createdAt}
        ctaHref={ctaHref}
        ctaLabel={ctaLabel}
        emphasis={emphasis}
        eyebrow={eyebrow}
        heroImage={heroImage}
        intro={intro}
        lang={lang}
        mobileHeroImage={mobileHeroImage}
        slot="banner"
        tags={tags}
        title={title}
        variant={variant}
    />
    <slot />
</BaseLayout>
