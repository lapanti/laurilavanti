---
import type { Lang } from '../content/nav'
import type { BreadcrumbItem, JsonLdType } from '../lib/jsonld'

import HeroPreloadLinks from '../components/HeroPreloadLinks.astro'
import Stripe from '../components/Stripe.astro'
import TitleBanner from '../components/TitleBanner.astro'
import { breadcrumbLabels } from '../lib/breadcrumbs'
import { getImage } from '../lib/images'
import { COLLECTIONPAGE } from '../lib/jsonld'
import { ogId } from '../lib/og/id'
import BaseLayout from './BaseLayout.astro'

interface Props {
    alt?: string
    createdAt?: string
    ctaHref?: string
    ctaLabel?: string
    description?: string
    emphasis?: string
    eyebrow?: string
    heroImage?: string
    intro?: string
    lang?: Lang
    mobileHeroImage?: string
    noindex?: boolean
    pageTitle: string
    plated?: boolean
    slug?: string
    tags?: string[]
    title: string
    type?: JsonLdType
    updatedAt?: string
    variant?: 'page' | 'split'
}

// Support both MDX layout usage (props under frontmatter) and direct .astro component usage
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const props: Props = ((Astro.props as any).frontmatter as Props | undefined) ?? (Astro.props as Props)
const {
    alt,
    createdAt,
    ctaHref,
    ctaLabel,
    description,
    emphasis,
    eyebrow,
    heroImage,
    intro,
    lang,
    mobileHeroImage,
    noindex,
    pageTitle,
    plated = false,
    slug,
    tags,
    title,
    type,
    updatedAt,
    variant = 'page',
} = props

/*
 * Pages with a canonical slug get a generated per-page card; slug-less pages (e.g. 404)
 * fall back to the static default social card.
 */
const ogImage = slug
    ? new URL(`/og/${ogId(slug)}.png`, Astro.site).href
    : getImage('og-image-lauri-lavanti', 'ogFlat').src

const breadcrumbs: BreadcrumbItem[] | undefined =
    type === COLLECTIONPAGE && lang && slug
        ? [
              { name: breadcrumbLabels.home[lang], url: `https://lavanti.fi/${lang}/` },
              { name: breadcrumbLabels.category[lang], url: `https://lavanti.fi/${slug}/` },
          ]
        : undefined
---

<BaseLayout
    breadcrumbs={breadcrumbs}
    createdAt={createdAt}
    description={description}
    headerVariant={variant === 'split' ? 'hero' : 'solid'}
    lang={lang}
    noindex={noindex}
    ogImage={ogImage}
    ogImageAlt="Lauri Lavanti"
    plated={plated}
    slug={slug}
    title={pageTitle}
    type={type}
    updatedAt={updatedAt}
>
    <Fragment slot="head">
        <HeroPreloadLinks
            heroImage={heroImage}
            mobileHeroImage={mobileHeroImage}
            mode={variant === 'split' ? 'art-directed' : 'page'}
        />
    </Fragment>
    <TitleBanner
        alt={alt}
        createdAt={createdAt}
        ctaHref={ctaHref}
        ctaLabel={ctaLabel}
        emphasis={emphasis}
        eyebrow={eyebrow}
        heroImage={heroImage}
        intro={intro}
        lang={lang}
        mobileHeroImage={mobileHeroImage}
        slot="banner"
        tags={tags}
        title={title}
        variant={variant}
    />
    <Stripe size="slim" />
    <slot />
</BaseLayout>
