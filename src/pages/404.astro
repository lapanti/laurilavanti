---
import ExcerptList from '../components/ExcerptList.astro'
import Plate from '../components/Plate.astro'
import PageLayout from '../layouts/PageLayout.astro'
import { getAllPosts } from '../lib/posts'

const pathname = Astro.url.pathname
const langMatch = pathname.match(/^\/(en|sv)\//)
const lang = langMatch ? (langMatch[1] as 'en' | 'sv') : 'fi'

const i18n = {
    en: {
        alt: 'Lauri Lavanti stands in front of a glass wall, wearing a dark blazer and a patterned shirt. Photo: Markus Isomeri.',
        title: 'The page you were looking for was unfor­tunately not found — could it be one of these?',
    },
    fi: {
        alt: 'Lauri Lavanti seisoo lasiseinän edessä tummassa pikkutakissa ja kuviollisessa paidassa. Kuva: Markus Isomeri.',
        title: 'Etsimääsi sivua ei valitet­tavasti löytynyt, olisiko se joku seuraavista?',
    },
    sv: {
        alt: 'Lauri Lavanti står framför en glasvägg, iklädd en mörk kavaj och en mönstrad skjorta. Foto: Markus Isomeri.',
        title: 'Sidan du letade efter hittades tyvärr inte — kan det vara någon av dessa?',
    },
}
const t = i18n[lang]

// Minimal lookup table: "lang/id" → canonical URL, serialised into the page for the redirect script
const allPosts = await getAllPosts()
const postIndexJson = JSON.stringify(Object.fromEntries(allPosts.map((p) => [p.lang + '/' + p.id, p.url])))
---

<script is:inline set:html={'window.__postIndex=' + postIndexJson + ';'} />
<script
    is:inline
    set:html={`
    (function () {
        var postIndex = window.__postIndex
        var match = window.location.pathname.match(/^\\/(fi|sv|en)\\/blog\\/(\\d+)\\//)
        if (match && postIndex) {
            var canonical = postIndex[match[1] + '/' + match[2]]
            if (canonical) {
                window.location.replace(canonical)
            }
        }
    })()
`}
/>

<PageLayout
    alt={t.alt}
    heroImage="Lauri-Lavanti-dipolissa-lasijulkisivun-edessa-hero-pysty"
    lang={lang}
    mobileHeroImage="Lauri-Lavanti-dipolissa-lasijulkisivun-edessa-hero-vaaka"
    pageTitle={t.title}
    plated
    title={t.title}
    variant="split"
>
    <Plate ground="white">
        <ExcerptList lang={lang} limit={8} />
    </Plate>
</PageLayout>
