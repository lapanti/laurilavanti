---
import type { Lang } from '../../../content/nav'
import type { LocalTag } from '../../../content/tags'

import ExcerptList from '../../../components/ExcerptList.astro'
import Paragraph from '../../../components/Paragraph.astro'
import { tags } from '../../../content/tags'
import PageLayout from '../../../layouts/PageLayout.astro'
import { COLLECTIONPAGE } from '../../../lib/jsonld'

export function getStaticPaths() {
    const langs: Lang[] = ['fi', 'sv', 'en']

    return langs.flatMap((lang) => tags.map((tag) => ({ params: { lang, tag: tag.id }, props: { tag } })))
}

interface Props {
    tag: LocalTag
}

const { tag } = Astro.props
const { lang } = Astro.params as { lang: Lang }

const heroImageFallback = 'Lauri-Lavanti-kannettavan-tietokoneen-aarella-nelio'
const heroImageAltFallback: Record<Lang, string> = {
    en: 'Lauri Lavanti sitting on stone steps with a laptop on his lap, smiling and looking to the side. Photo: Markus Isomeri.',
    fi: 'Lauri Lavanti istuu kivisillä portailla kannettava tietokone sylissään ja hymyilee sivulle päin. Kuva: Markus Isomeri.',
    sv: 'Lauri Lavanti sitter på stentrappor med en bärbar dator i knät och ler åt sidan. Foto: Markus Isomeri.',
}

const faq = tag.faq?.[lang]
const metaDescription = tag.metaDescription[lang]
const bodyParagraphs = tag.descriptions[lang]
---

<PageLayout
    alt={tag.heroImageAlt?.[lang] ?? heroImageAltFallback[lang]}
    description={metaDescription}
    faq={faq}
    heroImage={tag.heroImage ?? heroImageFallback}
    lang={lang}
    pageTitle={tag.pageTitle[lang]}
    slug={`${lang}/category/${tag.id}`}
    title={tag.pageTitle[lang]}
    type={COLLECTIONPAGE}
>
    {bodyParagraphs.map((p) => <Paragraph>{p}</Paragraph>)}
    <ExcerptList lang={lang} tag={tag.id} />
</PageLayout>
