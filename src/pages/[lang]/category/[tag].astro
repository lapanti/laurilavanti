---
import type { Lang } from '../../../content/nav'
import type { LocalTag } from '../../../content/tags'

import ExcerptList from '../../../components/ExcerptList.astro'
import Paragraph from '../../../components/Paragraph.astro'
import Plate from '../../../components/Plate.astro'
import PostProse from '../../../components/post/PostProse.astro'
import { tags } from '../../../content/tags'
import PageLayout from '../../../layouts/PageLayout.astro'
import { COLLECTIONPAGE } from '../../../lib/jsonld'

export function getStaticPaths() {
    const langs: Lang[] = ['fi', 'sv', 'en']

    return langs.flatMap((lang) => tags.map((tag) => ({ params: { lang, tag: tag.id }, props: { tag } })))
}

interface Props {
    tag: LocalTag
}

const { tag } = Astro.props
const { lang } = Astro.params as { lang: Lang }

const heroImageFallback = 'Lauri-Lavanti-lasijulkisivun-edessa-hero-pysty'
const mobileHeroImageFallback = 'Lauri-Lavanti-lasijulkisivun-edessa-hero-vaaka'
const heroImageAltFallback: Record<Lang, string> = {
    en: 'Lauri Lavanti stands in front of a glass wall, wearing a dark blazer and a patterned shirt. Photo: Markus Isomeri.',
    fi: 'Lauri Lavanti seisoo lasiseinän edessä tummassa pikkutakissa ja kuviollisessa paidassa. Kuva: Markus Isomeri.',
    sv: 'Lauri Lavanti står framför en glasvägg, iklädd en mörk kavaj och en mönstrad skjorta. Foto: Markus Isomeri.',
}

const faq = tag.faq?.[lang]
const metaDescription = tag.metaDescription[lang]
const bodyParagraphs = tag.descriptions[lang]
const [intro, ...restParagraphs] = bodyParagraphs
---

<PageLayout
    alt={tag.heroImageAlt?.[lang] ?? heroImageAltFallback[lang]}
    description={metaDescription}
    faq={faq}
    heroImage={tag.heroImage ?? heroImageFallback}
    intro={intro}
    lang={lang}
    mobileHeroImage={mobileHeroImageFallback}
    pageTitle={tag.pageTitle[lang]}
    plated
    slug={`${lang}/category/${tag.id}`}
    title={tag.pageTitle[lang]}
    type={COLLECTIONPAGE}
    variant="split"
>
    <Plate ground="white">
        <PostProse>
            {restParagraphs.map((p) => <Paragraph>{p}</Paragraph>)}
            <ExcerptList lang={lang} tag={tag.id} />
        </PostProse>
    </Plate>
</PageLayout>
