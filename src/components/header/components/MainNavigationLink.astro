---
import type { Lang } from '../../../content/nav'

import { colors, sizes } from '../../../lib/styles'
import NameLogo from '../../NameLogo.astro'

interface Props {
    lang?: Lang
    tone?: 'dark' | 'light'
}

const { lang = 'fi', tone = 'light' } = Astro.props
const { pathname } = Astro.url
const href = `/${lang}/`
const underlineColor = tone === 'light' ? colors.white : colors.forestGreen
---

<style
    define:vars={{
        sizes01875: sizes[0.1875],
        sizes5: sizes[5],
        underlineColor,
    }}
>
    a {
        align-items: center;
        display: flex;
        min-height: var(--sizes5);
        position: relative;
        overflow: hidden;
    }

    a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: var(--sizes01875);
        opacity: 1;
        transform: translate3d(-100%, 0, 0);
        background-color: var(--underlineColor);
    }

    @media (prefers-reduced-motion: no-preference) {
        a::after {
            transition: transform 200ms ease-in-out;
        }
    }

    a:hover::after,
    a:focus::after {
        transform: translate3d(0, 0, 0);
    }

    a:focus-visible {
        outline: var(--sizes01875) solid var(--underlineColor);
        outline-offset: 2px;
    }

    a[aria-current='page']:hover::after,
    a[aria-current='page']:focus::after {
        transform: translate3d(-100%, 0, 0);
    }
</style>
<a aria-current={pathname === href ? 'page' : 'false'} href={href}>
    <NameLogo size="small" tone={tone} />
</a>
