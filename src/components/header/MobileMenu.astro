---
/* eslint-disable astro/no-unused-css-selector */
import type { Lang, NavLink } from '../../content/nav'

import { navigationLabels } from '../../content/nav'
import { colors, CONTENT_PADDING, CONTENT_SIZE, HEADER_SIZE, sizes } from '../../lib/styles'
import MainNavigationLink from './components/MainNavigationLink.astro'
import NavigationLink from './components/NavigationLink.astro'

interface Props {
    lang?: Lang
    links: NavLink[]
}

const { lang = 'fi', links } = Astro.props
const labels = navigationLabels[lang]
---

<style
    define:vars={{
        colorsEvening: colors.evening,
        colorsPeach: colors.peach,
        contentPadding: CONTENT_PADDING,
        contentSize: CONTENT_SIZE,
        headerSize: HEADER_SIZE,
        sizes05: sizes[0.5],
        sizes025: sizes[0.25],
        sizes3: sizes[3],
        sizes25: sizes[2.5],
    }}
>
    .container {
        align-items: center;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        margin-left: var(--contentPadding);
        margin-right: var(--contentPadding);
        min-width: 0;
        width: var(--contentSize);
    }

    .container > div {
        align-items: center;
        display: flex;
        gap: var(--sizes25);
        width: 50%;
        justify-content: flex-start;
    }

    .container > div ~ div {
        justify-content: flex-end;
    }

    .menu-toggle {
        background: transparent;
        border: 0;
        cursor: pointer;
        display: block;
        height: var(--sizes3);
        padding: 0;
        position: absolute;
        right: var(--sizes05);
        width: var(--sizes3);
        z-index: 5;
    }

    .hamburger-lines-container {
        display: flex;
        flex-direction: column;
        height: var(--sizes25);
        justify-content: space-between;
        padding-bottom: var(--sizes025);
        padding-top: var(--sizes025);
        position: absolute;
        right: var(--sizes05);
        width: var(--sizes3);
        z-index: 2;
    }

    .line1,
    .line2,
    .line3 {
        display: block;
        height: var(--sizes025);
        width: 100%;
        border-radius: 10px;
        background: var(--colorsPeach);
        transition: transform 0.25s ease-in-out;
    }

    .line1 {
        transform-origin: 0% 0%;
    }

    .line2 {
        transition: transform 0.1s ease-in-out;
    }

    .line3 {
        transform-origin: 0% 100%;
    }

    .links {
        background: linear-gradient(
            90deg,
            rgba(0, 0, 0, 0.3) 0%,
            rgba(0, 0, 0, 0.15) 25%,
            rgba(255, 255, 255, 0) 50%,
            rgba(255, 255, 255, 0) 100%
        );
        background-color: var(--colorsEvening);
        height: 0;
        left: 0;
        overflow: hidden;
        position: absolute;
        top: var(--headerSize);
        transition: height 0.3s ease-in-out;
        width: 100vw;
    }

    .links ul {
        align-items: center;
        display: flex;
        flex-direction: column;
        gap: var(--sizes25);
        height: 100%;
        justify-content: center;
        list-style: none;
        margin: 0;
        padding: 0;
        width: 100%;
    }

    .links a {
        transition: opacity 0.3s ease-in-out;
        opacity: 0;
    }

    .menu-toggle[aria-expanded='true'] + .hamburger-lines-container > .line1 {
        transform: rotate(45deg);
    }

    .menu-toggle[aria-expanded='true'] + .hamburger-lines-container > .line2 {
        transform: scaleY(0);
    }

    .menu-toggle[aria-expanded='true'] + .hamburger-lines-container > .line3 {
        transform: rotate(-45deg);
    }

    .menu-toggle[aria-expanded='true'] ~ .links {
        height: calc(100dvh - var(--headerSize));
    }

    .menu-toggle[aria-expanded='true'] ~ .links a {
        opacity: 100%;
    }

    .menu-toggle:focus-visible {
        outline: var(--sizes025) solid var(--colorsPeach);
        outline-offset: 2px;
    }

    @media (min-width: 1200px) {
        .container,
        .links {
            display: none;
        }
    }

    @media (prefers-reduced-motion) {
        .links,
        .links a {
            transition: none;
        }
    }
</style>
<div class="container" data-mobile-menu>
    <div>
        <MainNavigationLink lang={lang} />
    </div>
    <div>
        <button
            aria-controls="mobile-primary-navigation"
            aria-expanded="false"
            aria-label={labels.openMenu}
            class="menu-toggle"
            data-close-label={labels.closeMenu}
            data-open-label={labels.openMenu}
            type="button"
        >
        </button>
        <div aria-hidden="true" class="hamburger-lines-container">
            <span class="line1"></span>
            <span class="line2"></span>
            <span class="line3"></span>
        </div>
        <nav aria-label={labels.primaryNavigation} class="links" hidden id="mobile-primary-navigation">
            <ul>
                {
                    links.map((link) => (
                        <li>
                            <NavigationLink
                                href={link.href}
                                label={link.label}
                                switchToLang={link.switchToLang}
                                title={link.title}
                            />
                        </li>
                    ))
                }
            </ul>
        </nav>
    </div>
</div>

<script src="./mobileMenu.ts"></script>
