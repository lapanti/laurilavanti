---
/* eslint-disable astro/no-unused-css-selector */
import type { Lang, NavLink } from '../../content/nav'

import { colors, CONTENT_PADDING, CONTENT_SIZE, HEADER_SIZE, sizes } from '../../lib/styles'
import MainNavigationLink from './components/MainNavigationLink.astro'
import NavigationLink from './components/NavigationLink.astro'

interface Props {
    lang?: Lang
    links: NavLink[]
    variant?: 'hero' | 'solid'
}

const { lang, links, variant = 'solid' } = Astro.props
const tone = variant === 'hero' ? 'light' : 'dark'
---

<style
    define:vars={{
        colorsDarkGreen: colors.darkGreen,
        colorsDeepForest: colors.forestGreen,
        colorsWhite: colors.white,
        contentPadding: CONTENT_PADDING,
        contentSize: CONTENT_SIZE,
        headerSize: HEADER_SIZE,
        sizes05: sizes[0.5],
        sizes025: sizes[0.25],
        sizes3: sizes[3],
        sizes25: sizes[2.5],
    }}
>
    .container {
        align-items: center;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        margin-left: var(--contentPadding);
        margin-right: var(--contentPadding);
        max-width: var(--contentSize);
        min-width: 0;
        /* margins sit outside the box even under border-box, so 100% here would
           overflow by 2x contentPadding — subtract them explicitly */
        width: calc(100% - (var(--contentPadding) * 2));
    }

    .container > div {
        align-items: center;
        display: flex;
        gap: var(--sizes25);
        width: 50%;
        justify-content: flex-start;
    }

    .container > div ~ div {
        justify-content: flex-end;
    }

    input[type='checkbox'] {
        position: absolute;
        display: block;
        height: var(--sizes3);
        width: var(--sizes3);
        right: var(--sizes05);
        top: 50%;
        transform: translateY(-50%);
        z-index: 5;
        opacity: 0;
        cursor: pointer;
    }

    .hamburger-lines-container {
        height: var(--sizes25);
        width: var(--sizes3);
        right: var(--sizes05);
        top: 50%;
        padding-top: var(--sizes025);
        padding-bottom: var(--sizes025);
        position: absolute;
        transform: translateY(-50%);
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .line1,
    .line2,
    .line3 {
        display: block;
        height: var(--sizes025);
        width: 100%;
        background: var(--colorsWhite);
        transition: transform 0.25s ease-in-out;
    }

    .hamburger-lines-container.dark .line1,
    .hamburger-lines-container.dark .line2,
    .hamburger-lines-container.dark .line3 {
        background: var(--colorsDeepForest);
    }

    .line1 {
        transform-origin: 0% 0%;
    }

    .line2 {
        transition: transform 0.1s ease-in-out;
    }

    .line3 {
        transform-origin: 0% 100%;
    }

    .links {
        align-items: center;
        background-color: var(--colorsDeepForest);
        border-bottom: 0 solid var(--colorsDarkGreen);
        display: flex;
        flex-direction: column;
        gap: var(--sizes25);
        justify-content: center;
        left: 0;
        overflow: hidden;
        position: absolute;
        top: var(--headerSize);
        transition: height 0.3s ease-in-out;
        width: 100vw;
        height: 0;
    }

    .links a {
        transition: opacity 0.3s ease-in-out;
        opacity: 0;
    }

    .container input[type='checkbox']:checked ~ div > .line1 {
        transform: rotate(45deg);
    }

    .container input[type='checkbox']:checked ~ div > .line2 {
        transform: scaleY(0);
    }

    .container input[type='checkbox']:checked ~ div > .line3 {
        transform: rotate(-45deg);
    }

    .container input[type='checkbox']:checked ~ .links {
        border-bottom-width: 4px;
        height: calc(100dvh - var(--headerSize));
    }

    .container input[type='checkbox']:checked ~ .links a {
        opacity: 100%;
    }

    @media (min-width: 769px) {
        .container,
        .links {
            display: none;
        }
    }

    @media (prefers-reduced-motion) {
        .links,
        .links a {
            transition: none;
        }
    }
</style>
<div class="container">
    <div>
        <MainNavigationLink lang={lang} tone={tone} />
    </div>
    <div>
        <input aria-label="Avaa valikko. Sulje valikko kun valittu." name="" type="checkbox" />
        <div class:list={['hamburger-lines-container', { dark: variant === 'solid' }]}>
            <span class="line1"></span>
            <span class="line2"></span>
            <span class="line3"></span>
        </div>
        <div class="links on-dark">
            {
                links.map((link) => (
                    <NavigationLink
                        context="mobile"
                        href={link.href}
                        label={link.label}
                        switchToLang={link.switchToLang}
                        title={link.title}
                    />
                ))
            }
        </div>
    </div>
</div>
