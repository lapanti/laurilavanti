---
import type { Lang, NavLink } from '../../content/nav'

import { navigationLabels } from '../../content/nav'
import { CONTENT_PADDING, CONTENT_SIZE, sizes } from '../../lib/styles'
import MainNavigationLink from './components/MainNavigationLink.astro'
import NavigationLink from './components/NavigationLink.astro'

interface Props {
    lang?: Lang
    links: NavLink[]
}

const { lang = 'fi', links } = Astro.props
---

<style define:vars={{ contentPadding: CONTENT_PADDING, contentSize: CONTENT_SIZE, sizes25: sizes[2.5] }}>
    .container {
        display: none;
        flex-direction: row;
        margin: auto;
        padding-left: var(--contentPadding);
        padding-right: var(--contentPadding);
        width: var(--contentSize);
    }

    .container > ul {
        align-items: center;
        display: flex;
        gap: var(--sizes25);
        justify-content: flex-start;
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .container > ul ~ ul {
        flex-grow: 1;
        justify-content: flex-end;
    }

    @media (min-width: 1200px) {
        .container {
            display: flex;
        }
    }
</style>
<nav aria-label={navigationLabels[lang].primaryNavigation} class="container">
    <ul>
        <li><MainNavigationLink lang={lang} /></li>
    </ul>
    <ul>
        {
            links.map((link) => (
                <li>
                    <NavigationLink
                        href={link.href}
                        label={link.label}
                        switchToLang={link.switchToLang}
                        title={link.title}
                    />
                </li>
            ))
        }
    </ul>
</nav>
