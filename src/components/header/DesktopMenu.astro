---
import type { Lang, NavLink } from '../../content/nav'

import { CONTENT_PADDING, CONTENT_SIZE } from '../../lib/styles'
import MainNavigationLink from './components/MainNavigationLink.astro'
import NavigationLink from './components/NavigationLink.astro'

interface Props {
    heroShowsMark?: boolean
    lang?: Lang
    links: NavLink[]
    variant?: 'hero' | 'solid'
}

const { heroShowsMark = false, lang, links, variant = 'solid' } = Astro.props
const navLinks = links.filter((link) => !link.switchToLang)
const langLinks = links.filter((link) => link.switchToLang)
const tone = variant === 'hero' ? 'dark' : 'light'
---

<style define:vars={{ contentPadding: CONTENT_PADDING, contentSize: CONTENT_SIZE }}>
    .container {
        display: none;
        align-items: center;
        flex-direction: row;
        gap: 24px;
        margin: auto;
        max-width: var(--contentSize);
        padding-left: var(--contentPadding);
        padding-right: var(--contentPadding);
        position: relative;
        width: 100%;
    }

    .brand {
        margin-right: auto;
    }

    /* The front page's hero has its own in-image wordmark, so the nav's copy is
       redundant there. Every other hero-variant page has no in-image mark — the nav's
       brand is its only logo, positioned to overhang the top of the dark hero column
       (package 20260824 8pm/Site/laurista.html: ".top .brand", Figma 2067:47750). */
    .brand.hidden {
        display: none;
    }

    .brand.overhang {
        left: 0;
        position: absolute;
        top: 14px;
    }

    nav {
        display: flex;
        gap: 14px;
        margin-left: auto;
    }

    .langs {
        display: flex;
        gap: 2.4px;
        margin-left: 32px;
    }

    @media (min-width: 769px) {
        .container {
            display: flex;
        }
    }
</style>
<div class="container">
    <div
        class:list={[
            'brand',
            { hidden: variant === 'hero' && heroShowsMark, overhang: variant === 'hero' && !heroShowsMark },
        ]}
    >
        <MainNavigationLink lang={lang} tone={tone} />
    </div>
    <nav aria-label="Päävalikko">
        {
            navLinks.map((link) => (
                <NavigationLink
                    context="desktop"
                    href={link.href}
                    label={link.label}
                    title={link.title}
                    variant={variant}
                />
            ))
        }
    </nav>
    <div class="langs" role="group">
        {
            langLinks.map((link) => (
                <NavigationLink
                    context="desktop"
                    href={link.href}
                    label={link.label}
                    switchToLang={link.switchToLang}
                    title={link.title}
                    variant={variant}
                />
            ))
        }
    </div>
</div>
