---
import type { Lang, NavLink } from '../../content/nav'

import { CONTENT_PADDING, CONTENT_SIZE } from '../../lib/styles'
import MainNavigationLink from './components/MainNavigationLink.astro'
import NavigationLink from './components/NavigationLink.astro'

interface Props {
    lang?: Lang
    links: NavLink[]
    variant?: 'hero' | 'solid'
}

const { lang, links, variant = 'solid' } = Astro.props
const navLinks = links.filter((link) => !link.switchToLang)
const langLinks = links.filter((link) => link.switchToLang)
const tone = variant === 'hero' ? 'dark' : 'light'
---

<style define:vars={{ contentPadding: CONTENT_PADDING, contentSize: CONTENT_SIZE }}>
    .container {
        display: none;
        align-items: center;
        flex-direction: row;
        gap: 24px;
        margin: auto;
        padding-left: var(--contentPadding);
        padding-right: var(--contentPadding);
        width: var(--contentSize);
    }

    .brand {
        margin-right: auto;
    }

    .brand.hero {
        display: none;
    }

    nav {
        display: flex;
        gap: 14px;
        margin-left: auto;
    }

    .langs {
        display: flex;
        gap: 2.4px;
        margin-left: 32px;
    }

    @media (min-width: 769px) {
        .container {
            display: flex;
        }
    }
</style>
<div class="container">
    <div class:list={['brand', { hero: variant === 'hero' }]}>
        <MainNavigationLink lang={lang} tone={tone} />
    </div>
    <nav aria-label="Päävalikko">
        {
            navLinks.map((link) => (
                <NavigationLink
                    context="desktop"
                    href={link.href}
                    label={link.label}
                    title={link.title}
                    variant={variant}
                />
            ))
        }
    </nav>
    <div class="langs" role="group">
        {
            langLinks.map((link) => (
                <NavigationLink
                    context="desktop"
                    href={link.href}
                    label={link.label}
                    switchToLang={link.switchToLang}
                    title={link.title}
                    variant={variant}
                />
            ))
        }
    </div>
</div>
