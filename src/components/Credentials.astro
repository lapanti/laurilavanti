---
import { colors, typographics } from '../lib/styles'

interface Props {
    items: string[]
}

const { items } = Astro.props
---

<style
    define:vars={{
        colorsSand: colors.sand,
        colorsTextPrimary: colors.textPrimary,
        credentialsFontFamily: typographics.text.fontFamily,
        credentialsFontWeight: typographics.pillarAnswer.fontWeight,
    }}
>
    .creds {
        display: grid;
        gap: 20px;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        padding-top: 48px;
    }

    .creds li {
        border-top: 4px solid var(--colorsSand);
        color: var(--colorsTextPrimary);
        font-family: var(--credentialsFontFamily);
        font-size: 15px;
        font-weight: var(--credentialsFontWeight);
        line-height: 21px;
        padding-top: 11.2px;
    }

    @media (max-width: 1199px) {
        .creds {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 768px) {
        .creds {
            gap: 12px;
            grid-template-columns: 1fr;
            padding-top: 32px;
        }

        .creds li {
            border-left: 4px solid var(--colorsSand);
            border-top: 0;
            padding: 4px 0 3px 12px;
        }
    }
</style>

<ul class="creds">
    {items.map((item) => <li>{item}</li>)}
</ul>
