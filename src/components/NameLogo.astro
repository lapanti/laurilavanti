---
import { colors, fontSizes, typographics } from '../lib/styles'

interface Props {
    size?: 'large' | 'small'
}

const { size = 'large' } = Astro.props
const { fontFamily, fontWeight } = typographics.h1
const { fontSize } = size === 'large' ? typographics.h1 : fontSizes[1.5]
const firstNameFontSize = size === 'large' ? '22px' : '10px'
---

<style define:vars={{ colorsWhite: colors.white, firstNameFontSize, fontFamily, fontSize, fontWeight }}>
    .name-logo {
        display: flex;
        flex-direction: column;
        transform: rotate(-10deg) skew(-10deg);
    }
    .name-logo span {
        color: var(--colorsWhite);
        font-family: var(--fontFamily);
        font-weight: var(--fontWeight);
        font-size: var(--fontSize);
        line-height: 1;
        text-transform: uppercase;
    }
    .name-logo .first-name {
        font-size: var(--firstNameFontSize);
    }
</style>
<span class="name-logo"><span class="first-name">Lauri</span> <span>Lavanti</span></span>
