---
import type { Lang } from '../content/nav'

interface Props {
    lang: Lang
}

const { lang } = Astro.props

const labels: Record<Lang, string> = {
    en: 'All posts',
    fi: 'Kaikki kirjoitukset',
    sv: 'Alla inlägg',
}

const hrefs: Record<Lang, string> = {
    en: '/en/blog/all/',
    fi: '/fi/blog/all/',
    sv: '/sv/blog/all/',
}
---

<style>
    .cta-wrapper {
        display: flex;
        justify-content: center;
        padding-top: 32px;
    }
</style>
<div class="cta-wrapper">
    <a class="btn btn--green" href={hrefs[lang]}>{labels[lang]}</a>
</div>
