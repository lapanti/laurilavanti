---
import { colors, typographics } from '../lib/styles'

interface Props {
    href: string
    variant?: 'forest' | 'green'
}

const { href, variant = 'forest' } = Astro.props
const buttonClass = variant === 'green' ? 'btn btn--green' : 'btn'
---

<style
    define:vars={{
        buttonFontFamily: typographics.button.fontFamily,
        buttonFontSize: typographics.button.fontSize,
        buttonFontWeight: typographics.button.fontWeight,
        buttonLetterSpacing: typographics.button.letterSpacing,
        buttonLineHeight: typographics.button.lineHeight,
        colorsDarkGreen: colors.darkGreen,
        colorsDeepForest: colors.forestGreen,
        colorsLightSand: colors.lightSand,
        colorsOffWhite: colors.offWhite,
    }}
>
    .btn {
        border: 2px solid currentcolor;
        color: var(--colorsDeepForest);
        display: inline-block;
        font-family: var(--buttonFontFamily);
        font-size: var(--buttonFontSize);
        font-weight: var(--buttonFontWeight);
        letter-spacing: var(--buttonLetterSpacing);
        line-height: var(--buttonLineHeight);
        padding: 16px 28px;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            background 0.18s var(--ease),
            color 0.18s var(--ease),
            transform 0.12s var(--ease);
    }

    .btn:hover {
        background: var(--colorsDeepForest);
        color: var(--colorsLightSand);
    }

    .btn:active {
        transform: translate(var(--press), var(--press));
    }

    .btn--green {
        color: var(--colorsDarkGreen);
    }

    .btn--green:hover {
        background: var(--colorsDarkGreen);
        color: var(--colorsOffWhite);
    }

    @media (max-width: 768px) {
        .btn {
            font-size: 18px;
            padding: 12px 20px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .btn {
            transition: none;
        }

        .btn:active {
            transform: none;
        }
    }
</style>

<a class:list={buttonClass} href={href}><slot /></a>
