---
import type { Lang } from '../content/nav'
import type { Recommendation as RecommendationType } from '../content/recommendations'

import Recommendation from './recommendations/Recommendation.astro'

interface Props {
    recommendations: RecommendationType[]
    lang: Lang
}

const { recommendations, lang } = Astro.props
---

<style>
    ul {
        display: grid;
        gap: 24px;
        grid-template-columns: 1fr;
        list-style: none;
        padding: 0;
        padding-top: 32px;
    }

    @media (min-width: 769px) {
        ul {
            gap: 40px;
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 1200px) {
        ul {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>
<ul class="recommendations-list">
    {
        recommendations.map((c) => (
            <li>
                <Recommendation
                    alt={c.locales[lang].alt}
                    image={c.image}
                    name={c.name}
                    recommendation={c.recommendation}
                    title={c.locales[lang].title}
                />
            </li>
        ))
    }
</ul>
<script
    is:inline
    set:html={`(function(){
    if (navigator.webdriver) return;
    var lists = document.querySelectorAll('.recommendations-list');
    for (var i = 0; i < lists.length; i++) {
        var items = Array.prototype.slice.call(lists[i].children);
        for (var j = items.length - 1; j > 0; j--) {
            var k = Math.floor(Math.random() * (j + 1));
            var tmp = items[j];
            items[j] = items[k];
            items[k] = tmp;
        }
        for (var m = 0; m < items.length; m++) {
            lists[i].appendChild(items[m]);
        }
    }
})();`}
/>
