---
interface Props {
    style?: string
}

const { style } = Astro.props
---

<style>
    ul {
        grid-column-start: 3;
        list-style: none;
        position: relative;
    }

    :global(.prose) ul {
        display: grid;
        gap: 12px;
        grid-column-start: auto;
    }
</style>
<ul style={style}>
    <slot />
</ul>
