---
import { colors, sizes } from '../lib/styles'

interface Props {
    ariaLabel?: string
    href: string
    rel?: string
}

const { ariaLabel, href, rel } = Astro.props
---

<style define:vars={{ colorsDarkGreen: colors.darkGreen, colorsDarkMoss: colors.darkMoss, sizes0125: sizes[0.125] }}>
    a {
        color: var(--colorsDarkMoss);
        text-decoration: underline;
        text-decoration-thickness: var(--sizes0125);
    }

    :global(.prose) a {
        color: inherit;
        text-decoration: underline;
        text-decoration-thickness: 1.5px;
        text-underline-offset: 3px;
    }

    :global(.prose) a:hover {
        color: var(--colorsDarkGreen);
    }
</style>
<a
    aria-label={ariaLabel ? `${ariaLabel} (linkki aukeaa uudessa välilehdessä)` : null}
    href={href}
    rel={`${rel ? rel : ''} noopener noreferrer`}
    target="_blank"><slot /></a
>
