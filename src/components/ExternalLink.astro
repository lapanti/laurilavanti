---
/**
 * Thin alias over Link's external mode — kept because MDX posts import it
 * directly; new code can use Link with `external` (or SmartLink) instead.
 */
import Link from './Link.astro'

interface Props {
    ariaLabel?: string
    href: string
    rel?: string
}

const { ariaLabel, href, rel } = Astro.props
---

<Link ariaLabel={ariaLabel} external href={href} rel={rel}><slot /></Link>
