---
import type { Lang } from '../content/nav'
import type { Slogan } from '../content/slogan'

import { colors } from '../lib/styles'
import Images from './heroBanner/Images.astro'
import Titles from './heroBanner/Titles.astro'

interface Props {
    alt?: string
    description: string
    heroImage?: string
    lang: Lang
    mobileHeroImage?: string
    slogan: Slogan
}

const { alt, description, heroImage, lang, mobileHeroImage, slogan } = Astro.props
---

<style define:vars={{ colorsDeepForest: colors.forestGreen }}>
    .hero {
        background: var(--colorsDeepForest);
        display: block;
        min-height: 0;
        position: relative;
    }

    @media (min-width: 769px) {
        .hero {
            display: grid;
            grid-template-columns: 330px minmax(0, 1fr);
            min-height: clamp(640px, 92svh, 899px);
        }
    }

    @media (min-width: 1000px) {
        .hero {
            grid-template-columns: 380px minmax(0, 1fr);
        }
    }

    @media (min-width: 1200px) {
        .hero {
            grid-template-columns: 470px minmax(0, 1fr);
        }
    }
</style>
<section class="hero">
    <Images alt={alt} heroImage={heroImage} mobileHeroImage={mobileHeroImage} />
    <Titles description={description} lang={lang} slogan={slogan} />
</section>
