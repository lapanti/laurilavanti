---
import { colors, typographics } from '../../lib/styles'
---

<style
    define:vars={{
        articleLeadFontFamily: typographics.articleLead.fontFamily,
        articleLeadFontSize: typographics.articleLead.fontSize,
        articleLeadFontWeight: typographics.articleLead.fontWeight,
        articleLeadLineHeight: typographics.articleLead.lineHeight,
        colorsTextPrimary: colors.textPrimary,
    }}
>
    .prose {
        margin-inline: auto;
        max-width: 800px;
        padding-top: 48px;
    }

    .prose > :global(* + *) {
        margin-top: 24px;
    }

    .prose > :global(p:first-of-type) {
        color: var(--colorsTextPrimary);
        font-family: var(--articleLeadFontFamily);
        font-size: var(--articleLeadFontSize);
        font-weight: var(--articleLeadFontWeight);
        line-height: var(--articleLeadLineHeight);
    }

    @media (max-width: 768px) {
        .prose {
            padding-top: 28px;
        }

        .prose > :global(* + *) {
            margin-top: 20px;
        }

        .prose > :global(p:first-of-type) {
            font-size: 19px;
            line-height: 1.5;
        }
    }
</style>
<div class="prose">
    <slot />
</div>
