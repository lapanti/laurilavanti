---
import { getImageSrcset } from '../../lib/images'
import { colors, typographics } from '../../lib/styles'

interface Props {
    alt: string
    recommendation: string
    image: string
    name: string
    title: string
}

const { alt, recommendation, image, name, title } = Astro.props
const img = image ? getImageSrcset(image, '1x1', [448, 896]) : undefined
---

<style
    define:vars={{
        colorsDarkGreen: colors.darkGreen,
        colorsSand: colors.sand,
        colorsTextPrimary: colors.textPrimary,
        colorsTextSecondary: colors.textSecondary,
        metaFontFamily: typographics.meta.fontFamily,
        metaFontWeight: typographics.meta.fontWeight,
        metaLetterSpacing: typographics.meta.letterSpacing,
        pillarAnswerFontFamily: typographics.pillarAnswer.fontFamily,
        pillarAnswerFontSize: typographics.pillarAnswer.fontSize,
        pillarAnswerLineHeight: typographics.pillarAnswer.lineHeight,
    }}
>
    article {
        border-top: 5px solid var(--colorsSand);
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding-top: 16px;
    }

    .portrait {
        overflow: hidden;
        width: 100%;
    }

    .portrait :global(img) {
        aspect-ratio: 1;
        object-fit: cover;
        width: 100%;
    }

    blockquote {
        margin: 0;
    }

    p {
        color: var(--colorsTextPrimary);
        font-family: var(--pillarAnswerFontFamily);
        font-size: var(--pillarAnswerFontSize);
        font-style: normal;
        line-height: var(--pillarAnswerLineHeight);
        margin: 0;
    }

    footer {
        display: flex;
        flex-direction: column;
        font-family: var(--metaFontFamily);
        margin-top: 12px;
    }

    footer cite {
        color: var(--colorsDarkGreen);
        font-style: normal;
        font-weight: var(--metaFontWeight);
    }

    footer span {
        color: var(--colorsTextSecondary);
        letter-spacing: var(--metaLetterSpacing);
    }
</style>
<article>
    {
        img && (
            <div class="portrait">
                <img
                    alt={alt}
                    height={img.height}
                    loading="lazy"
                    sizes="(max-width: 600px) 100vw, 448px"
                    src={img.src}
                    srcset={img.srcset}
                    style="width:100%;height:auto;"
                    width={img.width}
                />
            </div>
        )
    }
    <blockquote>
        {
            recommendation && (
                <p>
                    <em>{recommendation}</em>
                </p>
            )
        }
        <footer>
            <cite>{name}</cite>
            {title && <span>{title}</span>}
        </footer>
    </blockquote>
</article>
