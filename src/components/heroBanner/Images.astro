---
import { getImageSrcset, HERO_CONFIGS } from '../../lib/images'
import NameLogo from '../NameLogo.astro'

interface Props {
    alt?: string
    heroImage?: string
    mobileHeroImage?: string
    showMark?: boolean
}

const { alt, heroImage, mobileHeroImage, showMark = true } = Astro.props

const heroImg = heroImage
    ? getImageSrcset(heroImage, HERO_CONFIGS.portrait.variant, [...HERO_CONFIGS.portrait.widths])
    : undefined
const mobileImg = mobileHeroImage
    ? getImageSrcset(mobileHeroImage, HERO_CONFIGS.landscape.variant, [...HERO_CONFIGS.landscape.widths])
    : undefined
---

<style>
    .hero-left {
        overflow: hidden;
        position: relative;
    }

    .hero-left .bg {
        display: block;
        height: 222px;
        position: relative;
    }

    .hero-left .bg picture {
        display: contents;
    }

    .hero-left .bg img {
        height: 100%;
        object-fit: cover;
        object-position: 50% 40%;
        width: 100%;
    }

    .mark {
        display: none;
    }

    @media (min-width: 769px) {
        .hero-left .bg {
            height: 100%;
            position: absolute;
            inset: 0;
        }

        .hero-left .bg img {
            object-position: 100% 50%;
        }

        .mark {
            display: block;
            left: 40px;
            position: absolute;
            top: 40px;
            z-index: 1;
        }
    }

    @media (min-width: 1200px) {
        .mark {
            left: 64px;
            top: 64px;
        }
    }
</style>
<div class="hero-left">
    <div class="bg">
        {
            heroImg && mobileImg ? (
                <picture>
                    <source
                        height={heroImg.height}
                        media="(min-width: 769px)"
                        sizes={HERO_CONFIGS.portrait.sizes}
                        srcset={heroImg.srcset}
                        width={heroImg.width}
                    />
                    <img
                        alt={alt ?? ''}
                        fetchpriority="high"
                        height={mobileImg.height}
                        sizes={HERO_CONFIGS.landscape.sizes}
                        src={mobileImg.src}
                        srcset={mobileImg.srcset}
                        width={mobileImg.width}
                    />
                </picture>
            ) : (
                heroImg && (
                    <img
                        alt={alt ?? ''}
                        fetchpriority="high"
                        height={heroImg.height}
                        sizes={HERO_CONFIGS.single.sizes}
                        src={heroImg.src}
                        srcset={heroImg.srcset}
                        width={heroImg.width}
                    />
                )
            )
        }
    </div>
    {
        showMark && (
            <div class="mark">
                {/* NameLogo's "large" size renders ~138px wide; the front page's
                in-image mark wants 268px (package 20260824 8pm/Site/home.html:
                .hero-left .mark). */}
                <NameLogo scale={1.94} size="large" tone="light" />
            </div>
        )
    }
</div>
