---
import { getImageSrcset } from '../../lib/images'
import NameLogo from '../NameLogo.astro'

interface Props {
    alt?: string
    heroImage?: string
    mobileHeroImage?: string
    showMark?: boolean
}

const { alt, heroImage, mobileHeroImage, showMark = true } = Astro.props

const heroImg = heroImage ? getImageSrcset(heroImage, '1x1', [560, 720, 1120, 1680]) : undefined
const mobileImg = mobileHeroImage ? getImageSrcset(mobileHeroImage, '1x1', [560, 750, 1120, 1680]) : undefined
---

<style>
    .hero-left {
        overflow: hidden;
        position: relative;
    }

    .hero-left .bg {
        display: block;
        height: 222px;
        position: relative;
    }

    .hero-left .bg img {
        height: 100%;
        object-fit: cover;
        object-position: 50% 40%;
        width: 100%;
    }

    .mark {
        display: none;
    }

    .image-desktop {
        display: none;
    }

    @media (min-width: 769px) {
        .hero-left .bg {
            height: 100%;
            position: absolute;
            inset: 0;
        }

        .hero-left .bg img {
            object-position: 100% 50%;
        }

        .mark {
            display: block;
            left: 40px;
            position: absolute;
            top: 40px;
            z-index: 1;
        }

        .image-mobile {
            display: none;
        }

        .image-desktop {
            display: block;
        }
    }

    @media (min-width: 1200px) {
        .mark {
            left: 64px;
            top: 64px;
        }
    }
</style>
<div class="hero-left">
    <div class="bg">
        {
            heroImg && mobileImg ? (
                <>
                    <img
                        alt={alt ?? ''}
                        class="image-mobile"
                        fetchpriority="high"
                        height={mobileImg.height}
                        sizes="(max-width: 768px) 100vw, 470px"
                        src={mobileImg.src}
                        srcset={mobileImg.srcset}
                        width={mobileImg.width}
                    />
                    <img
                        alt={alt ?? ''}
                        class="image-desktop"
                        fetchpriority="high"
                        height={heroImg.height}
                        sizes="(max-width: 768px) 100vw, 470px"
                        src={heroImg.src}
                        srcset={heroImg.srcset}
                        width={heroImg.width}
                    />
                </>
            ) : (
                heroImg && (
                    <img
                        alt={alt ?? ''}
                        fetchpriority="high"
                        height={heroImg.height}
                        sizes="(max-width: 768px) 100vw, 470px"
                        src={heroImg.src}
                        srcset={heroImg.srcset}
                        width={heroImg.width}
                    />
                )
            )
        }
    </div>
    {
        showMark && (
            <div class="mark">
                <NameLogo size="large" tone="light" />
            </div>
        )
    }
</div>
