---
import type { Lang } from '../../content/nav'
import type { Slogan } from '../../content/slogan'

import { heroCtaLabel } from '../../content/slogan'
import { colors, typographics } from '../../lib/styles'

interface Props {
    description: string
    lang: Lang
    slogan: Slogan
}

const { description, lang, slogan } = Astro.props
---

<style
    define:vars={{
        colorsBrightGreen: colors.brightGreen,
        colorsDarkGreen: colors.darkGreen,
        colorsDeepForest: colors.forestGreen,
        colorsLightSand: colors.lightSand,
        displayFontFamily: typographics.display.fontFamily,
        displayFontWeight: typographics.display.fontWeight,
        displayLetterSpacing: typographics.display.letterSpacing,
        heroFootFontFamily: typographics.heroFoot.fontFamily,
        heroFootFontSize: typographics.heroFoot.fontSize,
        heroFootFontWeight: typographics.heroFoot.fontWeight,
        heroFootLineHeight: typographics.heroFoot.lineHeight,
        heroKickerFontFamily: typographics.heroKicker.fontFamily,
        heroKickerFontSize: typographics.heroKicker.fontSize,
        heroKickerFontWeight: typographics.heroKicker.fontWeight,
        heroKickerLetterSpacing: typographics.heroKicker.letterSpacing,
        heroKickerLineHeight: typographics.heroKicker.lineHeight,
    }}
>
    .hero-right {
        background: var(--colorsLightSand);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 24px 16px 32px;
    }

    .hero-kicker {
        color: var(--colorsDarkGreen);
        font-family: var(--heroKickerFontFamily);
        font-size: var(--heroKickerFontSize);
        font-weight: var(--heroKickerFontWeight);
        letter-spacing: var(--heroKickerLetterSpacing);
        line-height: var(--heroKickerLineHeight);
        text-transform: uppercase;
    }

    h1 {
        color: var(--colorsDeepForest);
        font-family: var(--displayFontFamily);
        font-size: 64px;
        font-weight: var(--displayFontWeight);
        letter-spacing: var(--displayLetterSpacing);
        line-height: 1;
        margin: 0;
        max-width: 1800px;
        padding: 16px 0 12px;
        text-transform: uppercase;
    }

    h1 em {
        color: var(--colorsBrightGreen);
        font-style: normal;
    }

    .hero-foot {
        align-items: center;
        display: flex;
        flex-direction: column;
        gap: 24px;
        text-align: left;
    }

    .hero-foot p {
        color: var(--colorsDeepForest);
        font-family: var(--heroFootFontFamily);
        font-size: var(--heroFootFontSize);
        font-weight: var(--heroFootFontWeight);
        line-height: var(--heroFootLineHeight);
        max-width: none;
    }

    @media (min-width: 769px) {
        .hero-right {
            padding: 128px 40px 32px 16px;
        }
        h1 {
            font-size: 72px;
        }
        .hero-foot {
            align-items: center;
            flex-direction: row;
            flex-wrap: wrap;
        }
        .hero-foot p {
            max-width: 480px;
        }
    }

    @media (min-width: 1000px) {
        .hero-right {
            padding-top: 128px;
        }
        h1 {
            font-size: 88px;
        }
    }

    @media (min-width: 1200px) {
        .hero-right {
            padding: 128px 56px 32px;
        }
        h1 {
            font-size: 120px;
        }
    }
</style>
<div class="hero-right">
    <p class="hero-kicker">
        {
            slogan.candidacy.map((line, i) => (
                <>
                    {i > 0 && <br />}
                    {line}
                </>
            ))
        }
    </p>
    <h1>
        {slogan.prefix}
        <em>{slogan.restingWord}</em>
    </h1>
    <div class="hero-foot">
        <p>{description}</p>
        <a class="btn" href="#driver">{heroCtaLabel[lang]}</a>
    </div>
</div>
