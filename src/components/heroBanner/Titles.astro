---
import type { Slogan } from '../../content/slogan'

import { colors, sizes, typographics } from '../../lib/styles'
import NameLogo from '../NameLogo.astro'

interface Props {
    title: string
    secondaryTitle?: string
    slogan?: Slogan
}

const { secondaryTitle, slogan } = Astro.props

const restingWord = slogan?.words.at(-1)
---

<style
    define:vars={{
        colorsWhite: colors.white,
        h2FontFamily: typographics.h2.fontFamily,
        h2FontSize: typographics.h2.fontSize,
        h2FontWeight: typographics.h2.fontWeight,
        h2LineHeight: typographics.h2.lineHeight,
        ingressFontFamily: typographics.ingress.fontFamily,
        ingressFontSize: typographics.ingress.fontSize,
        ingressFontWeight: typographics.ingress.fontWeight,
        ingressLineHeight: typographics.ingress.lineHeight,
        sizes0875: sizes[0.875],
        sizes3: sizes[3],
        sizes15: sizes[1.5],
        sizes375: sizes[3.75],
    }}
>
    div {
        color: var(--colorsWhite);
        display: flex;
        flex-direction: column;
        gap: var(--sizes15);
        margin-top: var(--sizes3);
        padding: var(--sizes0875);
    }

    h2 {
        font-family: var(--h2FontFamily);
        font-weight: var(--h2FontWeight);
        font-size: var(--h2FontSize);
        line-height: var(--h2LineHeight);
    }

    p {
        font-family: var(--ingressFontFamily);
        font-weight: var(--ingressFontWeight);
        font-size: var(--ingressFontSize);
        line-height: var(--ingressLineHeight);
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
    }

    /* Own line, reserved height: the growing word never reflows the prefix
       above it nor the candidacy line below it. */
    .typed {
        display: block;
        min-height: 1lh;
    }

    .typed::after {
        content: '▌';
        /* Keep the caret from adding width the resting word would jump over. */
        margin-left: -0.1em;
    }

    .typed[data-done]::after {
        content: none;
    }

    @media (prefers-reduced-motion: no-preference) {
        .typed::after {
            animation: caret-blink 1s step-end infinite;
        }

        @keyframes caret-blink {
            0%,
            100% {
                opacity: 1;
            }
            50% {
                opacity: 0;
            }
        }
    }

    @media (min-width: 1200px) {
        div {
            align-items: flex-start;
            gap: var(--sizes3);
            justify-content: flex-start;
            padding: var(--sizes375);
            width: 50%;
        }
    }
</style>
<div>
    <h1><NameLogo /></h1>
    {
        slogan ? (
            <Fragment>
                <h2>
                    {/* The accessible name stays fixed at the full resting slogan, so
                        screen readers and aria snapshots never see the animation. */}
                    <span class="sr-only">{`${slogan.prefix} ${restingWord}`}</span>
                    <span aria-hidden="true">
                        {slogan.prefix}
                        {/* Starts "done" — no caret — so the resting state is correct
                            whenever the animation never runs. The script clears it. */}
                        <span class="typed" data-done data-typed-words={JSON.stringify(slogan.words)}>
                            {restingWord}
                        </span>
                    </span>
                </h2>
                <p>{slogan.candidacy}</p>
            </Fragment>
        ) : (
            secondaryTitle && <h2>{secondaryTitle}</h2>
        )
    }
</div>

<script>
    /** Beat of empty, blinking caret before the first word appears. */
    const START_MS = 900
    const TYPE_MS = 70
    const DELETE_MS = 40
    const HOLD_MS = 1200
    const CLEARED_MS = 200

    const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))

    async function type(target: HTMLElement, word: string) {
        for (let i = 1; i <= word.length; i += 1) {
            target.textContent = word.slice(0, i)
            await sleep(TYPE_MS)
        }
    }

    async function erase(target: HTMLElement) {
        const word = target.textContent ?? ''
        for (let i = word.length - 1; i >= 0; i -= 1) {
            target.textContent = word.slice(0, i)
            await sleep(DELETE_MS)
        }
    }

    async function run(target: HTMLElement, words: string[]) {
        // Clear the server-rendered resting word straight away, then hold on an
        // empty blinking caret so the reader can settle before the first word.
        delete target.dataset.done
        target.textContent = ''
        await sleep(START_MS)

        for (const word of words.slice(0, -1)) {
            await type(target, word)
            await sleep(HOLD_MS)
            await erase(target)
            await sleep(CLEARED_MS)
        }

        await type(target, words[words.length - 1])
        // Rest on the final word: no loop, no caret.
        target.dataset.done = ''
    }

    // Leave the server-rendered resting word in place when motion is unwanted, and
    // when driven by Playwright so screenshots stay deterministic.
    if (!navigator.webdriver && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        for (const target of document.querySelectorAll<HTMLElement>('.typed')) {
            const words = JSON.parse(target.dataset.typedWords ?? '[]') as string[]

            if (words.length > 1) {
                void run(target, words)
            }
        }
    }
</script>
