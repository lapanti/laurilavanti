---
import { getExcerptPosts } from '../lib/posts'
import Excerpt from './excerptList/Excerpt.astro'

interface Props {
    currentSlug?: string
    excludeIds?: number[]
    lang?: 'en' | 'fi' | 'sv'
    limit?: number
    onlyIds?: number[]
    relatedTags?: string[]
    tag?: string
}

const { currentSlug, excludeIds, lang = 'fi', limit, onlyIds, relatedTags, tag } = Astro.props

const nodes = await getExcerptPosts({ currentSlug, excludeIds, lang, limit, onlyIds, relatedTags, tag })
---

<style>
    ul {
        display: grid;
        gap: 24px;
        grid-template-columns: 1fr;
    }

    @media (min-width: 769px) {
        ul {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 40px;
        }
    }

    @media (min-width: 1200px) {
        ul {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>
<ul>
    {
        nodes.map((node) => (
            <Excerpt
                alt={node.alt}
                date={node.publishDate}
                excerpt={node.description}
                image={node.heroImage}
                slug={node.url.replace(/^\//, '').replace(/\/$/, '')}
                title={node.title}
            />
        ))
    }
</ul>
