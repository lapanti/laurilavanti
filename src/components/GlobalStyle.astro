---
import { colors, typographics } from '../lib/styles'

const { button, chip, eyebrow, linkRule } = typographics
---

<style
    define:vars={{
        buttonFontFamily: button.fontFamily,
        buttonFontSize: button.fontSize,
        buttonFontWeight: button.fontWeight,
        buttonLetterSpacing: button.letterSpacing,
        buttonLineHeight: button.lineHeight,
        chipFontFamily: chip.fontFamily,
        chipFontSize: chip.fontSize,
        chipFontWeight: chip.fontWeight,
        chipLetterSpacing: chip.letterSpacing,
        chipLineHeight: chip.lineHeight,
        colorsAquaBlue: colors.aquaBlue,
        colorsBrightGreen: colors.brightGreen,
        colorsBrightSky: colors.brightSky,
        colorsDarkGreen: colors.darkGreen,
        colorsDeepForest: colors.forestGreen,
        colorsEyebrowNeutral: colors.eyebrowNeutral,
        colorsLightSand: colors.lightSand,
        colorsOat: colors.oat,
        colorsOffWhite: colors.offWhite,
        colorsSand: colors.sand,
        colorsSignalBlue: colors.signalBlue,
        colorsWhite: colors.white,
        eyebrowFontFamily: eyebrow.fontFamily,
        eyebrowFontSize: eyebrow.fontSize,
        eyebrowFontWeight: eyebrow.fontWeight,
        eyebrowLetterSpacing: eyebrow.letterSpacing,
        eyebrowLineHeight: eyebrow.lineHeight,
        linkRuleFontFamily: linkRule.fontFamily,
        linkRuleFontSize: linkRule.fontSize,
        linkRuleFontWeight: linkRule.fontWeight,
        linkRuleLetterSpacing: linkRule.letterSpacing,
        linkRuleLineHeight: linkRule.lineHeight,
    }}
    is:global
>
    *,
    ::before,
    ::after {
        border-color: currentcolor;
        border-style: solid;
        border-width: 0px;
        box-sizing: border-box;
    }
    /* big-shoulders-display-v24 - latin (variable, wght 100-900) */
    @font-face {
        font-display: swap;
        font-family: 'Big Shoulders Display';
        font-style: normal;
        font-weight: 100 900;
        src: url(/fonts/big-shoulders-display-v24-latin.woff2) format('woff2');
        unicode-range:
            U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
            U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }

    /* big-shoulders-display-v24 - latin-ext (variable, wght 100-900) */
    @font-face {
        font-display: swap;
        font-family: 'Big Shoulders Display';
        font-style: normal;
        font-weight: 100 900;
        src: url(/fonts/big-shoulders-display-v24-latin-ext.woff2) format('woff2');
        unicode-range:
            U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF,
            U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }

    /* ibm-plex-mono-regular - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Mono';
        font-style: normal;
        font-weight: 400;
        src:
            url(/fonts/ibm-plex-mono-v20-latin_latin-ext-regular.woff2) format('woff2'),
            /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
                url(/fonts/ibm-plex-mono-v20-latin_latin-ext-regular.ttf) format('truetype'); /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
    }

    /* ibm-plex-mono-italic - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Mono';
        font-style: italic;
        font-weight: 400;
        src:
            url(/fonts/ibm-plex-mono-v20-latin_latin-ext-italic.woff2) format('woff2'),
            /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
                url(/fonts/ibm-plex-mono-v20-latin_latin-ext-italic.ttf) format('truetype'); /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
    }

    /* ibm-plex-mono-500 - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Mono';
        font-style: normal;
        font-weight: 500;
        src:
            url(/fonts/ibm-plex-mono-v20-latin_latin-ext-500.woff2) format('woff2'),
            /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
                url(/fonts/ibm-plex-mono-v20-latin_latin-ext-500.ttf) format('truetype'); /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
    }

    /* ibm-plex-sans-300 - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 300;
        src:
            url(/fonts/ibm-plex-sans-v23-latin_latin-ext-300.woff2) format('woff2'),
            /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
                url(/fonts/ibm-plex-sans-v23-latin_latin-ext-300.ttf) format('truetype'); /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
    }

    /* ibm-plex-sans-regular - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 400;
        src:
            url(/fonts/ibm-plex-sans-v23-latin_latin-ext-regular.woff2) format('woff2'),
            /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
                url(/fonts/ibm-plex-sans-v23-latin_latin-ext-regular.ttf) format('truetype'); /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
    }

    /* ibm-plex-sans-italic - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Sans';
        font-style: italic;
        font-weight: 400;
        src:
            url(/fonts/ibm-plex-sans-v23-latin_latin-ext-italic.woff2) format('woff2'),
            /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
                url(/fonts/ibm-plex-sans-v23-latin_latin-ext-italic.ttf) format('truetype'); /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
    }

    /* ibm-plex-sans-600 - latin */
    @font-face {
        font-display: swap;
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 600;
        src: url(/fonts/ibm-plex-sans-v23-latin-600.woff2) format('woff2');
        unicode-range:
            U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F,
            U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }

    /* ibm-plex-sans-600 - latin-ext */
    @font-face {
        font-display: swap;
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 600;
        src: url(/fonts/ibm-plex-sans-v23-latin-ext-600.woff2) format('woff2');
        unicode-range:
            U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF,
            U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
    }

    /* ibm-plex-sans-500 - latin_latin-ext */
    @font-face {
        font-display: swap; /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
        font-family: 'IBM Plex Sans';
        font-style: normal;
        font-weight: 500;
        src:
            url(/fonts/ibm-plex-sans-v23-latin_latin-ext-500.woff2) format('woff2'),
            /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
                url(/fonts/ibm-plex-sans-v23-latin_latin-ext-500.ttf) format('truetype'); /* Chrome 4+, Firefox 3.5+, IE 9+, Safari 3.1+, iOS 4.2+, Android Browser 2.2+ */
    }

    a {
        color: inherit;
        text-decoration: inherit;
    }
    blockquote,
    dl,
    dd,
    h1,
    h2,
    h3,
    h4,
    h5,
    h6,
    hr,
    figure,
    p,
    pre {
        margin: 0px;
    }
    body {
        line-height: inherit;
        margin: 0px;
    }
    button,
    [role='button'] {
        cursor: pointer;
    }
    button,
    [type='button'],
    [type='reset'],
    [type='submit'] {
        appearance: button;
        background-color: transparent;
        background-image: none;
    }
    button,
    input,
    optgroup,
    select,
    textarea {
        color: inherit;
        font-family: inherit;
        font-feature-settings: inherit;
        font-size: 100%;
        font-variation-settings: inherit;
        font-weight: inherit;
        line-height: inherit;
        margin: 0px;
        padding: 0px;
    }
    button,
    select {
        text-transform: none;
    }
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        font-size: inherit;
        font-weight: inherit;
    }
    hr {
        border-top-width: 1px;
        color: inherit;
        height: 0px;
    }
    html {
        background-color: rgb(22, 62, 53);
        font-display: swap;
        font-family: 'IBM Plex Sans';
        font-feature-settings: normal;
        font-variation-settings: normal;
        line-height: 1.5;
        overflow-x: clip;
        tab-size: 4;
    }
    img,
    svg,
    video,
    canvas,
    audio,
    iframe,
    embed,
    object {
        display: block;
        vertical-align: middle;
    }
    ol,
    ul,
    menu {
        list-style: none;
        margin: 0px;
        padding: 0px;
    }

    /* ============================================================
       SIGNAL BAND — layout tokens, base treatments, shared primitives
       (visual rebrand)
       ============================================================ */
    :root {
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        --measure: 1152px;
        --pad-x: 56px;
        --press: 2px;
        --prose: 800px;
        --sec-y: 88px;
    }
    @media (max-width: 1199px) {
        :root {
            --pad-x: 40px;
        }
    }
    @media (max-width: 768px) {
        :root {
            --pad-x: 24px;
            --sec-y: 60px;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }
        .btn,
        .link-rule {
            transition: none;
        }
        .btn:active,
        .link-rule:active {
            transform: none;
        }
    }
    html {
        scroll-behavior: smooth;
        scrollbar-color: var(--colorsSand) var(--colorsLightSand);
        scrollbar-width: thin;
    }
    ::selection {
        background: var(--colorsBrightGreen);
        color: var(--colorsWhite);
    }
    :focus-visible {
        outline: 3px solid var(--colorsDarkGreen);
        outline-offset: 3px;
    }
    .on-dark :focus-visible {
        outline-color: var(--colorsOat);
    }

    /* layout primitives — a full-bleed shell, a centered measure, and the section rhythm */
    .sheet {
        margin-inline: auto;
        padding-inline: var(--pad-x);
        width: 100%;
    }
    .inner {
        margin-inline: auto;
        max-width: var(--measure);
        width: 100%;
    }
    .section {
        padding-block: var(--sec-y);
    }

    /* eyebrow — the tracked-uppercase label above a plate's heading */
    .eyebrow {
        color: var(--colorsEyebrowNeutral);
        display: block;
        font-family: var(--eyebrowFontFamily);
        font-size: var(--eyebrowFontSize);
        font-weight: var(--eyebrowFontWeight);
        letter-spacing: var(--eyebrowLetterSpacing);
        line-height: var(--eyebrowLineHeight);
        text-transform: uppercase;
    }

    /* buttons — flat and printed at rest, inverted on hover, a 2px press when held */
    .btn {
        border: 2px solid currentcolor;
        color: var(--colorsDeepForest);
        display: inline-block;
        font-family: var(--buttonFontFamily);
        font-size: var(--buttonFontSize);
        font-weight: var(--buttonFontWeight);
        letter-spacing: var(--buttonLetterSpacing);
        line-height: var(--buttonLineHeight);
        padding: 16px 28px;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            background 0.18s var(--ease),
            color 0.18s var(--ease),
            transform 0.12s var(--ease);
    }
    .btn:hover {
        background: var(--colorsDeepForest);
        color: var(--colorsLightSand);
    }
    .btn:active {
        transform: translate(var(--press), var(--press));
    }
    .btn--green {
        color: var(--colorsDarkGreen);
    }
    .btn--green:hover {
        background: var(--colorsDarkGreen);
        color: var(--colorsOffWhite);
    }
    @media (max-width: 768px) {
        .btn {
            font-size: 18px;
            padding: 12px 20px;
        }
    }

    /* link-rule — an underlined tracked-uppercase link, the only inline link treatment */
    .link-rule {
        border-bottom: 2px solid currentcolor;
        color: var(--colorsDarkGreen);
        display: inline-block;
        font-family: var(--linkRuleFontFamily);
        font-size: var(--linkRuleFontSize);
        font-weight: var(--linkRuleFontWeight);
        letter-spacing: var(--linkRuleLetterSpacing);
        line-height: var(--linkRuleLineHeight);
        padding-bottom: 3px;
        text-decoration: none;
        text-transform: uppercase;
        transition:
            color 0.18s var(--ease),
            transform 0.12s var(--ease);
    }
    .link-rule:hover {
        color: var(--colorsDeepForest);
    }
    .link-rule:active {
        transform: translate(1px, 1px);
    }

    /* the signal band stripe — five equal flex children, one per signal color */
    .stripes {
        display: flex;
        flex-direction: column;
        height: 220px;
    }
    .stripes i {
        flex: 1;
    }
    .stripes i:nth-child(1) {
        background: var(--colorsDarkGreen);
    }
    .stripes i:nth-child(2) {
        background: var(--colorsBrightGreen);
    }
    .stripes i:nth-child(3) {
        background: var(--colorsAquaBlue);
    }
    .stripes i:nth-child(4) {
        background: var(--colorsBrightSky);
    }
    .stripes i:nth-child(5) {
        background: var(--colorsSignalBlue);
    }
    @media (max-width: 768px) {
        .stripes {
            height: 100px;
        }
    }
    .stripes--slim {
        height: 132px;
    }
    @media (max-width: 768px) {
        .stripes--slim {
            height: 72px;
        }
    }

    /* vocab — static pillar vocabulary chips, deep forest at 14% opacity over the plate's own ground */
    .vocab {
        display: flex;
        flex-wrap: wrap;
        gap: 4.8px;
    }
    .vocab li {
        background: rgba(22, 62, 53, 0.14);
        font-family: var(--chipFontFamily);
        font-size: var(--chipFontSize);
        font-weight: var(--chipFontWeight);
        letter-spacing: var(--chipLetterSpacing);
        line-height: var(--chipLineHeight);
        padding: 4.48px 8.8px;
        text-transform: uppercase;
    }
</style>
