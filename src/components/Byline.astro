---
import type { AuthorEntry } from '../content/person'
import type { ExternalPublication } from '../lib/byline'

import { buildBylineText, formatPublicationDate, languageName } from '../lib/byline'
import { colors, typographics } from '../lib/styles'
import SmartLink from './SmartLink.astro'

interface Props {
    authors: AuthorEntry[]
    externalPublications?: ExternalPublication[]
    lang: 'en' | 'fi' | 'sv'
}

const { authors, externalPublications, lang } = Astro.props
const text = buildBylineText(authors, lang)

const publicationPrefix: Record<string, string> = {
    en: 'Also published in',
    fi: 'Julkaistu myös',
    sv: 'Publicerat även i',
}
---

<style
    define:vars={{
        bodyFontFamily: typographics.body.fontFamily,
        bodyFontSize: typographics.body.fontSize,
        bodyFontWeight: typographics.body.fontWeight,
        bodyLineHeight: typographics.body.lineHeight,
        colorsSand: colors.sand,
        colorsTextSecondary: colors.textSecondary,
        fineFontFamily: typographics.fine.fontFamily,
        fineFontSize: typographics.fine.fontSize,
        fineFontWeight: typographics.fine.fontWeight,
        fineLineHeight: typographics.fine.lineHeight,
    }}
>
    p {
        font-family: var(--bodyFontFamily);
        font-size: var(--bodyFontSize);
        font-weight: var(--bodyFontWeight);
        line-height: var(--bodyLineHeight);
        grid-column-start: 3;
        margin-block: 0;
    }

    :global(.prose) .byline {
        border-top: 3px solid var(--colorsSand);
        display: grid;
        gap: 6px;
        grid-column-start: auto;
        margin-top: 40px;
        padding-top: 18px;
    }

    :global(.prose) .byline p {
        color: var(--colorsTextSecondary);
        font-family: var(--fineFontFamily);
        font-size: var(--fineFontSize);
        font-weight: var(--fineFontWeight);
        grid-column-start: auto;
        line-height: var(--fineLineHeight);
    }
</style>
{
    (text || externalPublications) && (
        <div class="byline">
            {text && (
                <p>
                    <em>{text}</em>
                </p>
            )}
            {externalPublications?.map((pub: ExternalPublication) => {
                const pubLang = pub.lang ?? 'fi'
                const suffix = pubLang !== lang ? ` (${languageName[pubLang]})` : ''

                return (
                    <p>
                        {/* prettier-ignore */}
                        <em>{`${publicationPrefix[lang]}: `}{pub.url ? <SmartLink href={pub.url}>{pub.name}</SmartLink> : pub.name}{`, ${formatPublicationDate(pub.date, lang)}${suffix}.`}</em>
                    </p>
                )
            })}
        </div>
    )
}
