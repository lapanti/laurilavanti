---
import type { FaqItem } from '../../lib/jsonld'

import { colors, typographics } from '../../lib/styles'
import Eyebrow from '../Eyebrow.astro'
import PlateHeading from '../PlateHeading.astro'

interface Props {
    eyebrow: string
    faq: Array<FaqItem>
    heading: string
}

const { eyebrow, faq, heading } = Astro.props
---

<style
    define:vars={{
        colorsDeepForest: colors.forestGreen,
        colorsLightGray: colors.gray,
        colorsTextPrimary: colors.textPrimary,
        titleFontFamily: typographics.title.fontFamily,
        titleFontWeight: typographics.title.fontWeight,
    }}
>
    .faq {
        background: var(--colorsLightGray);
    }

    .qa {
        column-gap: 56px;
        display: grid;
        grid-template-columns: 1fr;
        padding-top: 32px;
    }

    .qa > div {
        border-top: 3px solid var(--colorsDeepForest);
        padding-block: 30.4px;
    }

    .qa h3 {
        color: var(--colorsDeepForest);
        font-family: var(--titleFontFamily);
        font-size: 19px;
        font-weight: var(--titleFontWeight);
        line-height: 24.7px;
        margin: 0;
    }

    .qa .a1 {
        color: var(--colorsTextPrimary);
        font-size: 17px;
        font-weight: 500;
        line-height: 1.68;
        margin: 0;
        padding-top: 10.4px;
    }

    @media (min-width: 769px) {
        .qa {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>
<section class="faq section">
    <div class="sheet">
        <div class="inner">
            <Eyebrow color={colors.darkGreen}>{eyebrow}</Eyebrow>
            <PlateHeading color={colors.forestGreen} sizes={['42px', '58px']}>{heading}</PlateHeading>
            <div class="qa">
                {
                    faq.map((item) => (
                        <div>
                            <h3>{item.q}</h3>
                            <p class="a1">{item.a}</p>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</section>
