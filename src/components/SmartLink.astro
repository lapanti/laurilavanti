---
import Link from './Link.astro'

interface Props {
    ariaLabel?: string
    heading?: boolean
    href: string
    rel?: string
}

const { ariaLabel, heading, href, rel } = Astro.props

const external = !href.startsWith('/')
---

<Link ariaLabel={ariaLabel} external={external} heading={heading} href={href} rel={rel}><slot /></Link>
