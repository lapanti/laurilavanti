---
import { colors, sizes } from '../lib/styles'

interface Props {
    heading?: boolean
    href: string
    rel?: string
}

const { heading, href, rel } = Astro.props
---

<style define:vars={{ colorsDarkGreen: colors.darkGreen, colorsDarkMoss: colors.darkMoss, sizes0125: sizes[0.125] }}>
    a {
        color: var(--colorsDarkMoss);
        text-decoration: underline;
        text-decoration-thickness: var(--sizes0125);
    }
    a.heading {
        display: block;
        min-block-size: 2.75rem;
    }

    :global(.prose) a {
        color: inherit;
        text-decoration: underline;
        text-decoration-thickness: 1.5px;
        text-underline-offset: 3px;
    }

    :global(.prose) a:hover {
        color: var(--colorsDarkGreen);
    }
</style>
<a class:list={[{ heading }]} href={href} rel={`${rel ? rel : ''}`}><slot /></a>
