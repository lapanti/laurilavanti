---
import { colors, sizes } from '../../lib/styles'
---

<style define:vars={{ colorsSand: colors.sand, sizes1: sizes[1] }}>
    hr {
        grid-column-start: 3;
        margin-bottom: var(--sizes1);
    }

    :global(.prose) hr {
        border: none;
        border-top: 2px solid var(--colorsSand);
        grid-column-start: auto;
        margin-block: 40px;
    }
</style>
<hr />
