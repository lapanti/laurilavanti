---
import { colors, typographics } from '../../lib/styles'

interface Props {
    allPostsHref: string
    allPostsLabel: string
    ground: 'sand' | 'offWhite'
    heading: string
    id: string
    intro: string[]
}

const { allPostsHref, allPostsLabel, ground, heading, id, intro } = Astro.props
const groundColor = {
    offWhite: colors.offWhite,
    sand: colors.lightSand,
}[ground]
---

<style
    define:vars={{
        topicPlateAnswerFontFamily: typographics.pillarAnswer.fontFamily,
        topicPlateDisplayFontFamily: typographics.display.fontFamily,
        topicPlateForestGreen: colors.forestGreen,
        topicPlateGround: groundColor,
        topicPlateTextFontFamily: typographics.text.fontFamily,
        topicPlateTextPrimary: colors.textPrimary,
    }}
>
    .topic {
        background: var(--topicPlateGround);
        padding-block: 5.5rem;
        scroll-margin-top: 3.5rem;
    }

    .topic-head {
        align-items: start;
        display: grid;
        gap: 1rem;
        /* 29rem fits KIRKKONUMMI (the widest tag name, 460px rendered) at 5.5rem Krana Fat */
        grid-template-columns: 29rem minmax(0, 1fr);
    }

    .topic-h {
        color: var(--topicPlateForestGreen);
        font-family: var(--topicPlateDisplayFontFamily);
        font-size: 5.5rem;
        font-weight: 900;
        hyphens: auto;
        letter-spacing: -0.02em;
        line-height: 1;
        margin: 0;
        overflow-wrap: break-word;
        padding-top: 0.375rem;
        text-transform: uppercase;
    }

    .topic-intro {
        display: grid;
        gap: 1.25rem;
        max-width: 620px;
    }

    .topic-intro p {
        color: var(--topicPlateTextPrimary);
        font-family: var(--topicPlateTextFontFamily);
        font-size: 1.0625rem;
        font-weight: 400;
        line-height: 1.68;
        margin: 0;
    }

    .topic-intro .answer {
        color: var(--topicPlateForestGreen);
        font-family: var(--topicPlateAnswerFontFamily);
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.5;
    }

    .topic-body {
        padding-top: 3.5rem;
    }

    .topic-more {
        line-height: 1.68;
        margin: 0;
        padding-top: 2.5rem;
    }

    @media (max-width: 1199px) {
        .topic-head {
            gap: 1.5rem;
            grid-template-columns: minmax(0, 1fr);
        }

        .topic-h {
            font-size: 4.5rem;
        }

        .topic-intro {
            max-width: none;
        }
    }

    @media (max-width: 768px) {
        .topic {
            padding-block: 3.75rem;
            scroll-margin-top: 6.5rem;
        }

        .topic-h {
            font-size: 3.25rem;
        }

        .topic-intro .answer {
            font-size: 1.1875rem;
        }

        .topic-body {
            padding-top: 2.5rem;
        }

        .topic-more {
            padding-top: 2rem;
        }
    }

    @media (max-width: 380px) {
        .topic-h {
            font-size: 2.75rem;
        }
    }
</style>

<section
    aria-labelledby={`${id}-h`}
    class:list={{
        topic: true,
        'topic--off': ground === 'offWhite',
        'topic--sand': ground === 'sand',
    }}
    id={id}
>
    <div class="sheet">
        <div class="inner">
            <div class="topic-head">
                <h2 class="topic-h" id={`${id}-h`}>{heading}</h2>
                <div class="topic-intro">
                    {intro.map((paragraph, index) => <p class:list={{ answer: index === 0 }}>{paragraph}</p>)}
                </div>
            </div>
            <div class="topic-body">
                <slot />
            </div>
            <p class="topic-more"><a class="link-rule" href={allPostsHref}>{allPostsLabel}</a></p>
        </div>
    </div>
</section>
