---
import { colors, typographics } from '../lib/styles'
---

<style
    define:vars={{
        colorsTextPrimary: colors.textPrimary,
        textFontFamily: typographics.text.fontFamily,
        textFontSize: typographics.text.fontSize,
        textFontWeight: typographics.text.fontWeight,
        textLineHeight: typographics.text.lineHeight,
    }}
>
    .prose {
        color: var(--colorsTextPrimary);
        font-family: var(--textFontFamily);
        font-size: var(--textFontSize);
        font-weight: var(--textFontWeight);
        line-height: var(--textLineHeight);
        max-width: 672px;
        padding-top: 24px;
    }

    /* Block flow rather than a grid: Paragraph carries an inline grid-column-start
       that would otherwise place slotted MDX paragraphs in the wrong column. */
    .prose > :global(* + *) {
        margin-top: 20px;
    }

    @media (max-width: 768px) {
        .prose {
            max-width: none;
        }

        .prose > :global(* + *) {
            margin-top: 16px;
        }
    }
</style>

<div class="prose"><slot /></div>
