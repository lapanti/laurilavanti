---
import type { Lang } from '../content/nav'

import {
    footerAriaLabel,
    footerColumnLabels,
    footerLanguageLinks,
    footerLinks,
    footerLogoAlt,
    footerPrivacyPolicyLabel,
    footerRssAriaLabel,
} from '../content/footer'
import { navLinks } from '../content/nav'
import { personEmail } from '../content/person'
import { colors, gridAreas, typographics } from '../lib/styles'
import InstagramLink from './footer/InstagramLink.astro'
import Link from './footer/Link.astro'
import TikTokLink from './footer/TikTokLink.astro'
import NameLogo from './NameLogo.astro'

interface Props {
    lang?: Lang
}

const { lang = 'fi' } = Astro.props
const getAriaLabel = footerAriaLabel[lang]
const columnLabels = footerColumnLabels[lang]
const siteLinks = navLinks[lang].filter((link) => !link.switchToLang)

const year = new Date().getFullYear()

const licenseText: Record<Lang, string> = {
    en: `© ${year} Lauri Lavanti. Content licensed under`,
    fi: `© ${year} Lauri Lavanti. Sisältö lisensoitu`,
    sv: `© ${year} Lauri Lavanti. Innehåll licensierat under`,
}
---

<style
    define:vars={{
        colorsAquaBlue: colors.aquaBlue,
        colorsDeepForest: colors.forestGreen,
        colorsFooterMuted: colors.footerMuted,
        colorsOat: colors.oat,
        gridAreasFooter: gridAreas.footer,
        headingFontFamily: typographics.eyebrow.fontFamily,
        headingFontSize: typographics.eyebrow.fontSize,
        headingFontWeight: typographics.eyebrow.fontWeight,
        headingLetterSpacing: typographics.eyebrow.letterSpacing,
        headingLineHeight: typographics.eyebrow.lineHeight,
    }}
>
    footer {
        background-color: var(--colorsDeepForest);
        color: var(--colorsAquaBlue);
        grid-area: var(--gridAreasFooter);
        padding: 40px 0 36px;
    }

    .footer-mark {
        /* generous clearance: NameLogo's rotate+skew overflows its own layout box by ~4x */
        padding: 40px 0 130px;
        /* the skew shifts the glyphs' visual left edge ~9px right of the box's actual
           edge — nudge back so the wordmark lines up with the columns below it */
        margin-left: -9px;
    }

    .foot-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
        gap: 32px;
        padding-bottom: 24px;
    }

    .foot-grid h2 {
        color: var(--colorsOat);
        font-family: var(--headingFontFamily);
        font-size: var(--headingFontSize);
        font-weight: var(--headingFontWeight);
        letter-spacing: var(--headingLetterSpacing);
        line-height: var(--headingLineHeight);
        text-transform: uppercase;
    }

    .foot-grid ul {
        display: grid;
        gap: 8.8px;
        padding-top: 16px;
    }

    .foot-grid a {
        color: var(--colorsAquaBlue);
        font-size: 15px;
        line-height: 25.2px;
        text-decoration: none;
    }

    .foot-grid a:hover {
        color: var(--colorsOat);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .foot-grid ul.social {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0;
        padding-top: 0;
    }

    .party {
        align-items: center;
        display: flex;
        gap: 24px;
        height: 100%;
    }

    .colophon {
        border-top: 2px solid rgba(191, 225, 222, 0.28);
        color: var(--colorsFooterMuted);
        font-size: 13px;
        line-height: 21.84px;
        margin-top: 32px;
        padding-top: 24px;
    }

    .colophon a {
        color: inherit;
    }

    @media (max-width: 1199px) {
        .foot-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .party {
            grid-column: 1 / -1;
            justify-content: flex-start;
        }
    }

    @media (max-width: 768px) {
        .footer-mark {
            padding: 24px 0 90px;
        }

        .foot-grid {
            grid-template-columns: 1fr;
            gap: 24px;
        }

        .foot-grid ul.social {
            display: grid;
            grid-template-columns: repeat(4, auto);
            gap: 12px;
            justify-content: start;
        }

        .party {
            align-items: flex-start;
            flex-direction: column;
            gap: 16px;
            justify-content: flex-start;
            padding-top: 8px;
        }
    }
</style>
<footer class="on-dark" id="footer">
    <div class="sheet">
        <div class="inner">
            <div class="footer-mark">
                <a href={`/${lang}/`}>
                    <NameLogo size="large" tone="light" />
                </a>
            </div>
            <div class="foot-grid">
                <div>
                    <h2>{columnLabels.site}</h2>
                    <ul>
                        {
                            siteLinks.map((link) => (
                                <li>
                                    <a href={link.href}>{link.label}</a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
                <div>
                    <h2>{columnLabels.languages}</h2>
                    <ul>
                        {
                            footerLanguageLinks.map((link) => (
                                <li>
                                    <a href={link.href}>{link.label}</a>
                                </li>
                            ))
                        }
                    </ul>
                </div>
                <div>
                    <h2>{columnLabels.contact}</h2>
                    <ul>
                        <li><a href={`mailto:${personEmail}`}>{personEmail}</a></li>
                        <li><a href={`/${lang}/privacy-policy/`}>{footerPrivacyPolicyLabel[lang]}</a></li>
                    </ul>
                </div>
                <div class="party">
                    <ul class="social">
                        {
                            footerLinks.map((link) =>
                                link.icon === 'instagram' ? (
                                    <InstagramLink
                                        ariaLabel={getAriaLabel(link.title)}
                                        title={link.title}
                                        url={link.url}
                                    />
                                ) : link.icon === 'tiktok' ? (
                                    <TikTokLink
                                        ariaLabel={getAriaLabel(link.title)}
                                        title={link.title}
                                        url={link.url}
                                    />
                                ) : (
                                    <Link
                                        ariaLabel={getAriaLabel(link.title)}
                                        icon={link.icon}
                                        title={link.title}
                                        url={link.url}
                                    />
                                )
                            )
                        }
                        <Link
                            ariaLabel={footerRssAriaLabel[lang]}
                            icon="fa7-solid:rss"
                            title="RSS"
                            url={`/${lang}/rss.xml`}
                        />
                    </ul>
                    <img
                        alt={footerLogoAlt[lang]}
                        height="65"
                        loading="lazy"
                        src="/logos/Vihreiden-logo-suomeksi-ruotsiksi-ja-englanniksi.svg"
                        width="184"
                    />
                </div>
            </div>
            <p class="colophon">
                {licenseText[lang]}
                {' '}
                <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">CC BY-SA 4.0</a>.
            </p>
        </div>
    </div>
</footer>
