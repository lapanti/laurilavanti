{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "packageRules": [
        {
            "description": "Never automerge major updates — always open a PR for human review",
            "matchUpdateTypes": ["major"],
            "automerge": false
        },
        {
            "description": "Astro ecosystem",
            "groupName": "astro",
            "matchPackageNames": ["astro", "@astrojs/**", "eslint-plugin-astro"]
        },
        {
            "description": "Linting, formatting, and types",
            "groupName": "lint and types",
            "matchPackageNames": [
                "eslint",
                "eslint-**",
                "@eslint/**",
                "@stylistic/**",
                "typescript",
                "typescript-eslint",
                "@typescript-eslint/**",
                "prettier",
                "@types/**"
            ]
        },
        {
            "description": "Testing tools",
            "groupName": "testing",
            "matchPackageNames": ["vitest", "@vitest/**", "playwright", "@playwright/**", "@axe-core/playwright"]
        },
        {
            "description": "One PR for all non-major updates — main is protected with strict mode and 15 required checks, so a per-package PR invalidates every other open PR the moment one merges, and the queue stalls",
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "groupName": "all non-major dependencies"
        },
        {
            "description": "Automerge non-major updates once required CI checks pass",
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "automerge": true,
            "platformAutomerge": true
        }
    ]
}
